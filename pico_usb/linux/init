#!/bin/sh
export PATH=/sbin:/bin:/usr/sbin:/usr/bin
mount -t devtmpfs devtmpfs /dev
mount -t proc proc /proc
mount -t sysfs sysfs /sys
echo
echo "DAQ-LINUX: unified USB and Ethernet runtime started"

# Linux owns GEM3. The DAQ debug/mailbox/DMA region begins at 0x0F000000 and
# is outside Linux RAM (the loader boots with mem=240M).
i=0
while [ ! -e /sys/class/net/eth0 ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done
if [ -e /sys/class/net/eth0 ]; then
    ip link set eth0 down || true
    ip addr flush dev eth0 || true
    ip addr add 192.168.2.10/24 dev eth0
    ip link set eth0 up
    /usr/sbin/daq-eth-service >/dev/ttyPS0 2>&1 &
    echo "DAQ-ETH: service launched at 192.168.2.10:5006"
else
    echo "DAQ-ETH: WARNING - Linux GEM interface eth0 was not created"
fi

echo "PICO-HOST: Linux USB host started; preserving installed Pico firmware"

i=0
while [ ! -e /dev/ttyACM0 ] && [ "$i" -lt 50 ]; do
    sleep 0.1
    i=$((i + 1))
done

if [ -c /dev/ttyACM0 ]; then
    /usr/sbin/pico-bridge-service >/dev/ttyPS0 2>&1 &
    echo "PICO-BRIDGE: service launched at UDP port 5007 and MB mailbox 0x1003FE00"
    echo "PICO-HOST: READY - existing Pico CDC firmware preserved"
else
    echo "PICO-HOST: ERROR - installed Pico firmware did not expose USB CDC"
fi

echo "PICO-HOST: maintenance shell ready"
exec /bin/sh
